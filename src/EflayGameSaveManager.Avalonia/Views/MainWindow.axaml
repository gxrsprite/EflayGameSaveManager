<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EflayGameSaveManager.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="860"
        x:Class="EflayGameSaveManager.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Background="#F5F7FA"
        Title="{Binding Strings.WindowTitle}">

    <Window.Styles>
        <Style Selector="Path.icon-stroke">
            <Setter Property="Stroke" Value="#1B2A3A"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Margin="20">
        <Border Background="#FFFFFF" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="18" Padding="18">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Strings.AppName}" FontSize="28" FontWeight="Bold" Foreground="#1B2A3A"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#5F7288"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="0,0,10,0"
                            Content="{Binding Strings.ToggleInfo}"
                            Command="{Binding ToggleHeaderCommand}" />
                    <Button Grid.Column="2"
                            Margin="0,0,10,0"
                            Content="{Binding Strings.RefreshCloud}"
                            MinWidth="150"
                            Command="{Binding RefreshCloudStatusCommand}" />
                    <Button Grid.Column="3"
                            Margin="0,0,10,0"
                            Content="{Binding Strings.BackupAllCloud}"
                            MinWidth="180"
                            Command="{Binding UploadAllBackupsToCloudCommand}" />
                    <Button Grid.Column="4"
                            Margin="0,0,10,0"
                            Content="{Binding Strings.BackupAllSaves}"
                            MinWidth="150"
                            Command="{Binding ExportAllSavesCommand}" />
                    <Button Grid.Column="5"
                            Margin="0,0,10,0"
                            Content="{Binding Strings.RestoreAllSaves}"
                            MinWidth="150"
                            Command="{Binding RestoreAllSavesCommand}" />
                    <Button Grid.Column="6"
                            Content="{Binding Strings.Reload}"
                            MinWidth="120"
                            Command="{Binding ReloadCommand}" />
                </Grid>

                <Border IsVisible="{Binding IsHeaderExpanded}"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Version, StringFormat=Config version: {0}}"/>
                        <TextBlock Text="{Binding CurrentDeviceName, StringFormat=Current device: {0}}"/>
                        <TextBlock Text="{Binding ConfigPath, StringFormat=Config: {0}}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding BackupPath, StringFormat=Backup root: {0}}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LogPath, StringFormat=Log: {0}}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CloudSummary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="18" Margin="0,18,0,0">
            <Border Background="#FFFFFF" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="18" Padding="14">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Content="{Binding Strings.Games}"
                                Command="{Binding ShowGameListCommand}" />
                        <Button Grid.Column="1"
                                Content="{Binding Strings.AddGame}"
                                Command="{Binding ShowAddGameCommand}" />
                        <Button Grid.Column="2"
                                Content="{Binding Strings.Settings}"
                                Command="{Binding ShowSettingsCommand}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid IsVisible="{Binding IsGameListView}" RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock Text="{Binding Games.Count, StringFormat=Games: {0}}" FontSize="16" FontWeight="SemiBold"/>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Games}"
                                     SelectedItem="{Binding SelectedGame}"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.AllowAutoHide="False">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameListItemViewModel">
                                        <Border Padding="12" Margin="0,0,0,8" Background="#F8FAFC" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                                <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" Foreground="#5F7288"/>
                                                <TextBlock Text="{Binding CloudBadge}" Foreground="#5F7288"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <StackPanel IsVisible="{Binding IsAddGameView}" Spacing="10">
                            <TextBlock Text="{Binding Strings.AddGame}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Strings.AddGameHint}" TextWrapping="Wrap" Foreground="#5F7288"/>
                            <Button Content="{Binding Strings.AddFolderSave}"
                                    Command="{Binding AddFolderSaveUnitCommand}" />
                            <Button Content="{Binding Strings.AddFileSave}"
                                    Command="{Binding AddFileSaveUnitCommand}" />
                            <Button Content="{Binding Strings.AddRegistrySave}"
                                    Command="{Binding AddRegistrySaveUnitCommand}" />
                            <Button Content="{Binding Strings.AddZipSave}"
                                    Command="{Binding AddZipSaveUnitCommand}" />
                            <Button Content="{Binding Strings.ResetForm}"
                                    Command="{Binding ResetAddGameCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="18" Padding="18">
                <Grid>
                <ScrollViewer IsVisible="{Binding IsGameListView}"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              AllowAutoHide="False">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding SelectedGameName}" FontSize="24" FontWeight="Bold" Foreground="#1B2A3A"/>
                            <TextBlock Text="{Binding SelectedGameNote}" IsVisible="{Binding HasSelectedGameNote}" TextWrapping="Wrap" Foreground="#5F7288"/>
                            <TextBlock Text="{Binding SelectedGameStats}" Foreground="#5F7288"/>
                            <TextBlock Text="{Binding SelectedGameCloudState}" Foreground="#394B5A"/>
                        </StackPanel>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12"
                                IsVisible="{Binding HasSelectedGame}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Strings.GameInfoHint}" TextWrapping="Wrap" Foreground="#5F7288"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Strings.GameChineseName}" VerticalAlignment="Center" Foreground="#1B2A3A"/>
                                    <TextBox Grid.Column="1" Text="{Binding EditGameChineseName}" Watermark="{Binding Strings.GameChineseName}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Strings.GameNote}" VerticalAlignment="Center" Foreground="#1B2A3A"/>
                                    <TextBox Grid.Column="1" Text="{Binding EditGameNote}" Watermark="{Binding Strings.GameNote}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding UploadSelectedGameCurrentSaveCommand}"
                                    IsEnabled="{Binding SelectedGameCanSync}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Classes="icon-stroke"
                                                  Data="M6.5,18 C4.0,18 2.0,16.1 2.0,13.8 C2.0,11.6 3.7,9.8 5.8,9.6 C6.5,6.9 9.0,5 11.9,5 C15.1,5 17.8,7.4 18.2,10.5 C20.3,10.9 22.0,12.6 22.0,14.8 C22.0,17.0 20.1,18.0 18.1,18.0"
                                                  Fill="Transparent"/>
                                            <Path Classes="icon-stroke"
                                                  Data="M12,18 L12,10 M8.7,13.3 L12,10 L15.3,13.3"
                                                  Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Strings.SyncCurrentSave}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RestoreSelectedGameCurrentSaveCommand}"
                                    IsEnabled="{Binding SelectedGameCanSync}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Classes="icon-stroke"
                                                  Data="M6.5,18 C4.0,18 2.0,16.1 2.0,13.8 C2.0,11.6 3.7,9.8 5.8,9.6 C6.5,6.9 9.0,5 11.9,5 C15.1,5 17.8,7.4 18.2,10.5 C20.3,10.9 22.0,12.6 22.0,14.8 C22.0,17.0 20.1,18.0 18.1,18.0"
                                                  Fill="Transparent"/>
                                            <Path Classes="icon-stroke"
                                                  Data="M12,10 L12,18 M8.7,14.7 L12,18 L15.3,14.7"
                                                  Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Strings.RestoreFromCloud}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RestoreSelectedGameLatestSaveCommand}"
                                    IsEnabled="{Binding SelectedGameCanSync}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Classes="icon-stroke"
                                                  Data="M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 M12,7 L12,12 L15,14"
                                                  Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Strings.RestoreLatestFromCloud}"/>
                                </StackPanel>
                            </Button>
                            <Button Content="{Binding Strings.RunGame}"
                                    Command="{Binding RunCurrentGameCommand}"
                                    IsEnabled="{Binding HasSelectedGame}" />
                            <Button Content="{Binding Strings.OpenGameFolder}"
                                    Command="{Binding OpenCurrentGameFolderCommand}"
                                    IsEnabled="{Binding HasSelectedGame}" />
                            <Button Content="{Binding Strings.SaveDeviceSettings}"
                                    Command="{Binding SaveCurrentDevicePathsCommand}"
                                    IsEnabled="{Binding HasSelectedGame}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Strings.SavePaths}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                    <TextBlock Text="{Binding SelectedGameSaveSummary}" TextWrapping="Wrap" Foreground="#394B5A"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Strings.Executables}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                    <TextBlock Text="{Binding SelectedGameExecutableSummary}" TextWrapping="Wrap" Foreground="#394B5A"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Strings.CurrentGameExecutable}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding CurrentDeviceGamePath}" Watermark="{Binding Strings.CurrentGameExecutableHint}"/>
                                    <Button Grid.Column="1"
                                            Content="{Binding Strings.OpenFolder}"
                                            Command="{Binding OpenCurrentGameFolderCommand}" />
                                    <Button Grid.Column="2"
                                            Content="{Binding Strings.SelectPath}"
                                            Command="{Binding ChooseCurrentGamePathCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#F7F8FF" BorderBrush="#C9D1F4" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Strings.ExternalLaunchers}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                        <TextBlock Text="{Binding Strings.ExternalLauncherHint}" Foreground="#5F7288" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{Binding Strings.AddExternalProgram}"
                                            Command="{Binding AddExternalLauncherCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding CurrentDeviceExternalLaunchers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExternalLauncherEditorViewModel">
                                            <Grid Margin="0,0,0,8"
                                                  ColumnDefinitions="150,*,Auto,Auto,Auto"
                                                  ColumnSpacing="8">
                                                <TextBox Text="{Binding Category}"
                                                         Watermark="Category (for example Modifier)"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Path}"
                                                         Watermark="Full path to the external program"/>
                                                <Button Grid.Column="2"
                                                        Content="Run"
                                                        Command="{Binding RunCommand}"/>
                                                <Button Grid.Column="3"
                                                        Content="Select Path"
                                                        Command="{Binding ChoosePathCommand}"/>
                                                <Button Grid.Column="4"
                                                        Content="Remove"
                                                        Command="{Binding RemoveCommand}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="#F5FBFF" BorderBrush="#B9D7EA" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                    <TextBlock Text="{Binding CloudBackups.Count, StringFormat=Cloud Backups: {0}}"
                                               FontWeight="SemiBold"
                                               Foreground="#1B2A3A"/>
                                    <Button Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Content="{Binding Strings.RebuildIndex}"
                                            Command="{Binding RebuildSelectedGameCloudBackupsManifestCommand}"
                                            IsEnabled="{Binding SelectedGameCanSync}" />
                                    <Button Grid.Column="2"
                                            Margin="0,0,8,0"
                                            Content="{Binding Strings.DownloadZip}"
                                            Command="{Binding DownloadSelectedCloudBackupZipCommand}"
                                            IsEnabled="{Binding HasSelectedCloudBackup}" />
                                    <Button Grid.Column="3"
                                            Margin="0,0,8,0"
                                            Content="{Binding Strings.RestoreSelected}"
                                            Command="{Binding RestoreSelectedCloudBackupCommand}"
                                            IsEnabled="{Binding HasSelectedCloudBackup}" />
                                    <Button Grid.Column="4"
                                            Content="{Binding Strings.DeleteSelected}"
                                            Command="{Binding DeleteSelectedCloudBackupCommand}"
                                            IsEnabled="{Binding HasSelectedCloudBackup}" />
                                </Grid>

                                <ListBox MaxHeight="220"
                                         ItemsSource="{Binding CloudBackups}"
                                         SelectedItem="{Binding SelectedCloudBackup}"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.AllowAutoHide="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CloudBackupItemViewModel">
                                            <Border Padding="10" Margin="0,0,0,8" Background="#FFFFFF" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="10">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding HeadBadge}" Foreground="#18794E"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Foreground="#5F7288"/>
                                                    <TextBlock Text="{Binding Describe, StringFormat=Describe: {0}}" Foreground="#5F7288"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFDF5" BorderBrush="#E8D9A8" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Strings.CurrentDeviceSavePaths}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                <ItemsControl ItemsSource="{Binding CurrentDevicePaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CurrentSavePathEditorViewModel">
                                            <StackPanel Spacing="4" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding SaveUnitId, StringFormat=Save unit {0}}" Foreground="#394B5A"/>
                                                <TextBlock Text="{Binding UnitType}" Foreground="#394B5A"/>
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBox Text="{Binding Path}" Watermark="Enter current device save path"/>
                                                    <Button Grid.Column="1"
                                                            Content="Open Folder"
                                                            Command="{Binding OpenPathCommand}" />
                                                    <Button Grid.Column="2"
                                                            Content="Select Path"
                                                            Command="{Binding ChoosePathCommand}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Strings.ExcludePatterns}"
                                                               VerticalAlignment="Center"
                                                               Foreground="#5F7288"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding ExcludePatterns}"
                                                             Watermark="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Strings.ExcludePatternsWatermark}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Strings.ExcludePatternsHint}"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Foreground="#8A9AAB"/>
                                                <CheckBox IsChecked="{Binding ContentsOnly}"
                                                          Content="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Strings.ContentsOnly}"/>
                                                <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Strings.ContentsOnlyHint}"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Foreground="#8A9AAB"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="#F5FFF5" BorderBrush="#B9D7B9" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Text="{Binding LocalBackups.Count, StringFormat=Local Backups: {0}}"
                                               FontWeight="SemiBold"
                                               Foreground="#1B2A3A"/>
                                    <Button Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Content="{Binding Strings.BackupLocal}"
                                            Command="{Binding BackupLocalCommand}"
                                            IsEnabled="{Binding HasSelectedGame}" />
                                    <Button Grid.Column="2"
                                            Margin="0,0,8,0"
                                            Content="{Binding Strings.RestoreSelected}"
                                            Command="{Binding RestoreLocalBackupCommand}"
                                            IsEnabled="{Binding HasSelectedLocalBackup}" />
                                    <Button Grid.Column="3"
                                            Content="{Binding Strings.DeleteSelected}"
                                            Command="{Binding DeleteLocalBackupCommand}"
                                            IsEnabled="{Binding HasSelectedLocalBackup}" />
                                </Grid>

                                <ListBox MaxHeight="180"
                                         ItemsSource="{Binding LocalBackups}"
                                         SelectedItem="{Binding SelectedLocalBackup}"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.AllowAutoHide="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LocalBackupItemViewModel">
                                            <Border Padding="10" Margin="0,0,0,8" Background="#FFFFFF" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="10">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding HeadBadge}" Foreground="#18794E"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Foreground="#5F7288"/>
                                                    <TextBlock Text="{Binding Describe, StringFormat=Describe: {0}}" Foreground="#5F7288"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding IsAddGameView}"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              AllowAutoHide="False">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Strings.AddGame}" FontSize="24" FontWeight="Bold" Foreground="#1B2A3A"/>
                            <TextBlock Text="{Binding Strings.AddGameDescription}" Foreground="#5F7288"/>
                        </StackPanel>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Strings.Game}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                <TextBox Text="{Binding AddGameName}" Watermark="{Binding Strings.GameName}"/>
                                <TextBox Text="{Binding AddGameChineseName}" Watermark="{Binding Strings.GameChineseName}"/>
                                <TextBox Text="{Binding AddGameNote}" Watermark="{Binding Strings.GameNote}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding AddGamePath}" Watermark="{Binding Strings.OptionalGameExecutable}"/>
                                    <Button Grid.Column="1"
                                            Content="{Binding Strings.SelectPath}"
                                            Command="{Binding ChooseAddGamePathCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFDF5" BorderBrush="#E8D9A8" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                    <TextBlock Text="{Binding AddGameSaveUnits.Count, StringFormat=Save Units: {0}}"
                                               FontWeight="SemiBold"
                                               Foreground="#1B2A3A"/>
                                    <Button Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Content="{Binding Strings.Folder}"
                                            Command="{Binding AddFolderSaveUnitCommand}" />
                                    <Button Grid.Column="2"
                                            Margin="0,0,8,0"
                                            Content="{Binding Strings.File}"
                                            Command="{Binding AddFileSaveUnitCommand}" />
                                    <Button Grid.Column="3"
                                            Margin="0,0,8,0"
                                            Content="{Binding Strings.Registry}"
                                            Command="{Binding AddRegistrySaveUnitCommand}" />
                                    <Button Grid.Column="4"
                                            Content="Zip"
                                            Command="{Binding AddZipSaveUnitCommand}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding AddGameSaveUnits}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AddGameSaveUnitEditorViewModel">
                                            <StackPanel Spacing="6" Margin="0,0,0,12">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding SaveUnitId, StringFormat=Unit {0}}" FontWeight="SemiBold" Foreground="#394B5A"/>
                                                        <TextBlock Text="{Binding UnitTypeText}" Foreground="#5F7288"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Remove"
                                                            Command="{Binding RemoveCommand}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBox Text="{Binding Path}" Watermark="{Binding PathWatermark}"/>
                                                    <Button Grid.Column="1"
                                                            Content="Select Path"
                                                            Command="{Binding ChoosePathCommand}"
                                                            IsEnabled="{Binding CanChoosePath}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Strings.ExcludePatterns}"
                                                               VerticalAlignment="Center"
                                                               Foreground="#5F7288"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding ExcludePatterns}"
                                                             Watermark="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Strings.ExcludePatternsWatermark}"/>
                                                </Grid>
                                                <CheckBox IsChecked="{Binding ContentsOnly}"
                                                          Content="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Strings.ContentsOnly}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="#F5FBFF" BorderBrush="#B9D7EA" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Strings.PathTokens}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                <TextBlock Text="{Binding AddGameTokenHelp}" TextWrapping="Wrap" Foreground="#394B5A"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="{Binding Strings.CreateGame}"
                                    MinWidth="140"
                                    Command="{Binding CreateGameCommand}"
                                    IsEnabled="{Binding CanCreateGame}" />
                            <Button Content="{Binding Strings.Reset}"
                                    MinWidth="100"
                                    Command="{Binding ResetAddGameCommand}" />
                            <Button Content="{Binding Strings.BackToGames}"
                                    MinWidth="130"
                                    Command="{Binding ShowGameListCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer IsVisible="{Binding IsSettingsView}"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              AllowAutoHide="False">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Strings.Settings}" FontSize="24" FontWeight="Bold" Foreground="#1B2A3A"/>
                            <TextBlock Text="{Binding S3SettingsSummary}" Foreground="#5F7288" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Background="#F7F8FF" BorderBrush="#C9D1F4" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Strings.InterfaceLanguage}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                <TextBlock Text="{Binding Strings.InterfaceLanguageHint}" Foreground="#5F7288" TextWrapping="Wrap"/>
                                <ComboBox ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          HorizontalAlignment="Left"
                                          MinWidth="180">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LanguageOptionViewModel">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Strings.S3Storage}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="180,*"
                                      RowSpacing="10"
                                      ColumnSpacing="12">
                                    <TextBlock Text="{Binding Strings.Endpoint}" VerticalAlignment="Center" Foreground="#394B5A"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding S3Endpoint}"
                                             Watermark="https://s3.example.com"/>

                                    <TextBlock Grid.Row="1" Text="{Binding Strings.Bucket}" VerticalAlignment="Center" Foreground="#394B5A"/>
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Text="{Binding S3Bucket}"
                                             Watermark="game-saves"/>

                                    <TextBlock Grid.Row="2" Text="{Binding Strings.Region}" VerticalAlignment="Center" Foreground="#394B5A"/>
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Text="{Binding S3Region}"
                                             Watermark="auto"/>

                                    <TextBlock Grid.Row="3" Text="{Binding Strings.RootPath}" VerticalAlignment="Center" Foreground="#394B5A"/>
                                    <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             Text="{Binding S3RootPath}"
                                             Watermark="GameSaveManager"/>

                                    <TextBlock Grid.Row="4" Text="{Binding Strings.AccessKeyId}" VerticalAlignment="Center" Foreground="#394B5A"/>
                                    <TextBox Grid.Row="4"
                                             Grid.Column="1"
                                             Text="{Binding S3AccessKeyId}"/>

                                    <TextBlock Grid.Row="5" Text="{Binding Strings.SecretAccessKey}" VerticalAlignment="Center" Foreground="#394B5A"/>
                                    <TextBox Grid.Row="5"
                                             Grid.Column="1"
                                             Text="{Binding S3SecretAccessKey}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Strings.SyncOptions}" FontWeight="SemiBold" Foreground="#1B2A3A"/>
                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="180,*"
                                      RowSpacing="10"
                                      ColumnSpacing="12">
                                    <TextBlock Text="{Binding Strings.MaxConcurrency}" VerticalAlignment="Center" Foreground="#394B5A"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding S3MaxConcurrency}"
                                             Watermark="1"/>

                                    <TextBlock Grid.Row="1" Text="{Binding Strings.AutoSyncInterval}" VerticalAlignment="Center" Foreground="#394B5A"/>
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Text="{Binding S3AutoSyncInterval}"
                                             Watermark="0"/>

                                    <TextBlock Grid.Row="2" Text="{Binding Strings.AlwaysSync}" VerticalAlignment="Center" Foreground="#394B5A"/>
                                    <CheckBox Grid.Row="2"
                                              Grid.Column="1"
                                              IsChecked="{Binding S3AlwaysSync}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="{Binding Strings.SaveS3Settings}"
                                    MinWidth="160"
                                    Command="{Binding SaveS3SettingsCommand}" />
                            <Button Content="{Binding Strings.BackToGames}"
                                    MinWidth="130"
                                    Command="{Binding ShowGameListCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Window>
