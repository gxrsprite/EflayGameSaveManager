<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\EflayGameSaveManager.Maui\Services\MobileConfigNormalizer.cs" Link="Mobile\MobileConfigNormalizer.cs" />
    <Compile Include="..\..\src\EflayGameSaveManager.Maui\Services\AndroidGameSnapshotFactory.cs" Link="Mobile\AndroidGameSnapshotFactory.cs" />
    <Compile Include="..\..\src\EflayGameSaveManager.Maui\Services\MobileSaveUnitEditor.cs" Link="Mobile\MobileSaveUnitEditor.cs" />
    <None Include="..\..\distribution\cotl\*.json" Link="PublicProfile\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\GameSaveManager.config.json" Link="GameSaveManager.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EflayGameSaveManager.Core\EflayGameSaveManager.Core.csproj" />
  </ItemGroup>

</Project>
